-- Sources demo: a bookshop's analytics built entirely from raw local files.
-- Four files in four formats — CSV, newline-delimited JSON, a pipe-delimited
-- .txt, and Parquet — all pulled in through {{ source(...) }} and joined on
-- DuckDB. No database, no docker; everything is next to this notebook.
--   uv run quicksql run demo/sources/sources.qsql
--   uv run quicksql tui demo/sources/sources.qsql

-- @engine: duckdb
-- @output: { type: parquet, dir: data/ }

/*@
sources:
  books:   { path: seeds/books.csv }
  regions: { path: seeds/regions.txt, type: csv, sep: "|" }
vars:
  restock_threshold: 40
*/

-- @cell books
-- A named source declared in the header's `sources:` map. source('books')
-- looks it up and renders to read_csv_auto('.../seeds/books.csv').
SELECT book_id, title, author, genre, list_price
FROM {{ source('books') }};

-- @cell orders
-- A raw path — no `sources:` entry needed. The .ndjson extension picks the
-- json reader (read_json_auto), which handles newline-delimited JSON.
SELECT order_id, book_id, qty, unit_price, channel,
       CAST(ordered_at AS TIMESTAMP) AS ordered_at
FROM {{ source('seeds/orders.ndjson') }};

-- @cell regions
-- Reader options ride along with the named source: a pipe-delimited .txt read
-- as CSV because the header set `type: csv` and `sep: "|"` on it. Options can
-- also be passed inline: {{ source('regions', sep='|') }}.
SELECT channel, segment, commission_pct
FROM {{ source('regions') }};

-- @cell inventory
-- A raw path to the Parquet seed (generated by tools/gen_inventory.py) —
-- read_parquet, no options needed.
SELECT book_id, warehouse, on_hand
FROM {{ source('seeds/inventory.parquet') }};

-- @cell order_lines
-- source() and ref() compose: enrich each JSON order line with catalog fields
-- from the CSV, and compute line revenue and the discount off list price.
SELECT o.order_id,
       o.book_id,
       o.ordered_at,
       o.channel,
       b.title,
       b.genre,
       o.qty,
       o.unit_price,
       round(o.qty * o.unit_price, 2)                 AS revenue,
       round(o.qty * (b.list_price - o.unit_price), 2) AS discount_given
FROM {{ ref('orders') }} o
JOIN {{ ref('books') }} b USING (book_id);

-- @cell sales_by_segment
-- @output: { type: duckdb, path: warehouse.db }
-- Roll revenue up to the segment each channel maps to, with the wholesale
-- commission from regions. Lands in a DuckDB sink instead of the default
-- parquet.
SELECT r.segment,
       count(DISTINCT ol.order_id)                          AS orders,
       sum(ol.qty)                                          AS units,
       round(sum(ol.revenue), 2)                            AS revenue,
       round(sum(ol.revenue) * r.commission_pct / 100, 2)   AS commission
FROM {{ ref('order_lines') }} ol
JOIN {{ ref('regions') }} r USING (channel)
GROUP BY r.segment, r.commission_pct
ORDER BY revenue DESC;

-- @cell restock
-- @autorun: false
-- On demand (r in the TUI): titles whose total on-hand has dropped below the
-- threshold var — try --set vars.restock_threshold=20. Joins the Parquet
-- inventory against units sold from the order lines.
SELECT b.title,
       b.genre,
       inv.on_hand,
       coalesce(sold.units, 0)             AS units_sold,
       {{ var('restock_threshold') }}      AS threshold
FROM {{ ref('books') }} b
JOIN (
    SELECT book_id, sum(on_hand) AS on_hand
    FROM {{ ref('inventory') }}
    GROUP BY book_id
) inv USING (book_id)
LEFT JOIN (
    SELECT book_id, sum(qty) AS units
    FROM {{ ref('order_lines') }}
    GROUP BY book_id
) sold USING (book_id)
WHERE inv.on_hand < {{ var('restock_threshold') }}
ORDER BY inv.on_hand;
