-- Starting point for the "build a cell live" demo (demo/build.tape).
-- Two Postgres cells; the tape types the cross-engine DuckDB cell on camera.
-- Seed the tables with demo/seed.sql (see demo/README.md).

/*@
input: { postgres: { dsn: "postgresql://qsql:qsql@localhost:5432/qsql" } }
output: { type: parquet, dir: data/ }
*/

-- @cell shipped_by_tier
-- Runs IN postgres: the aggregation happens next to the 5k orders.
SELECT c.tier,
       count(*)                  AS orders,
       round(sum(o.amount), 2)   AS revenue
FROM orders o
JOIN customers c USING (customer_id)
WHERE o.status = 'shipped'
GROUP BY c.tier;

-- @cell top_customers
SELECT c.name,
       c.region,
       round(sum(o.amount), 2)   AS spend
FROM orders o
JOIN customers c USING (customer_id)
WHERE o.status <> 'refunded'
GROUP BY c.name, c.region
ORDER BY spend DESC
LIMIT 5;
