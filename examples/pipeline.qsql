-- Example pipeline: multi-sink, vars, autorun, run-time overrides. Offline-runnable:
--   uv run qsql run examples/pipeline.qsql
--   uv run qsql run examples/pipeline.qsql --set vars.top_n=2
--   uv run qsql tui examples/pipeline.qsql

-- @engine: duckdb
-- @output: { type: parquet, dir: data/ }

/*@
vars:
  top_n: 3
*/

-- @cell users
SELECT * FROM (VALUES
    (1, 'ada',  'engineering'),
    (2, 'bob',  'sales'),
    (3, 'cyd',  'engineering'),
    (4, 'dee',  'design')
) AS t(user_id, name, team);

-- @cell events
SELECT (range % 4 + 1)::INT AS user_id,
       CASE WHEN range % 3 = 0 THEN 'commit' ELSE 'review' END AS kind
FROM range(24);

-- lands as a table in a DuckDB file:
-- @cell team_activity
-- @output: { type: duckdb, path: warehouse.db }
SELECT u.team, e.kind, count(*) AS events
FROM {{ ref('users') }} u
JOIN {{ ref('events') }} e USING (user_id)
GROUP BY 1, 2;

-- reads the duckdb-sink table back:
-- @cell top_teams
SELECT team, sum(events) AS total
FROM {{ ref('team_activity') }}
GROUP BY 1
ORDER BY total DESC
LIMIT {{ var('top_n') }};

-- excluded from watch reruns:
-- @cell scratch_notes
-- @autorun: false
SELECT 'edit me without triggering the pipeline' AS note;
