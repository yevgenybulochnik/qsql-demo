/*@
input:
  postgres:
    dsn: postgresql://qsql:qsql@localhost:5432/qsql_claims
*/
-- Smoke test against the synthetic claims warehouse (examples/claims_seed.sql).
-- The three postgres cells run next to the data and land parquet; the last
-- cell runs on duckdb and combines their outputs cross-engine. In the TUI,
-- S -> the postgres context -> claims -> a table shows every column with its
-- type and COMMENT-sourced description.

-- @cell enrolled_members
SELECT plan_code, count(*) AS members
FROM claims.eligibility
WHERE term_date IS NULL
GROUP BY plan_code
ORDER BY members DESC;

-- @cell medical_paid
SELECT diagnosis_code,
       count(*)                 AS claim_lines,
       sum(paid_amount)         AS paid,
       sum(member_liability)    AS member_oop
FROM claims.medical_claims
WHERE claim_status = 'paid'
GROUP BY diagnosis_code
ORDER BY paid DESC;

-- @cell pharmacy_paid
SELECT drug_name,
       brand_generic,
       count(*)         AS fills,
       sum(plan_paid)   AS paid,
       sum(patient_pay) AS member_oop
FROM claims.pharmacy_claims
WHERE claim_status = 'paid'
GROUP BY drug_name, brand_generic
ORDER BY paid DESC;

-- @cell pmpm
-- @engine: duckdb
SELECT med.paid                                        AS medical_paid,
       rx.paid                                         AS pharmacy_paid,
       el.members,
       round((med.paid + rx.paid) / el.members / 18, 2) AS pmpm  -- 18 seeded months
FROM (SELECT sum(paid) AS paid FROM {{ ref('medical_paid') }}) med,
     (SELECT sum(paid) AS paid FROM {{ ref('pharmacy_paid') }}) rx,
     (SELECT sum(members) AS members FROM {{ ref('enrolled_members') }}) el;
