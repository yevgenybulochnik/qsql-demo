{
  "name": "quicksql",
  "displayName": "quicksql",
  "description": "Language support for quicksql SQL notebooks (.qsql): diagnostics, column completion, go-to-definition and cell outline via the quicksql language server.",
  "version": "0.1.0",
  "publisher": "quicksql",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yevgenybulochnik/qsql-demo"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:qsql"
  ],
  "contributes": {
    "languages": [
      {
        "id": "qsql",
        "aliases": [
          "quicksql",
          "qsql"
        ],
        "extensions": [
          ".qsql"
        ],
        "filenamePatterns": [
          "*.qsql.sql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qsql",
        "scopeName": "source.qsql",
        "path": "./syntaxes/qsql.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "quicksql",
      "properties": {
        "quicksql.serverPath": {
          "type": "string",
          "default": "quicksql",
          "description": "Path to the quicksql executable; the extension runs `<serverPath> lsp`. Install the server with: uv tool install 'quicksql[lsp]'"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "vscode:prepublish": "npm run compile",
    "test": "vscode-tmgrammar-test -g syntaxes/qsql.tmLanguage.json \"tests/*.qsql\"",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
